{
  "name": "deadwood",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "bot",
  "remoteUser": "vscode",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.inheritEnv": true,
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        }
      },
      "extensions": [
        "adam-bender.commit-message-editor",
        "adpyke.vscode-sql-formatter",
        "charliermarsh.ruff",
        "christian-kohler.path-intellisense",
        "codeium.codeium",
        "cweijan.vscode-database-client2",
        "donjayamanne.githistory",
        "editorconfig.editorconfig",
        "formulahendry.auto-close-tag",
        "formulahendry.auto-rename-tag",
        "Gruntfuggly.todo-tree",
        "hbenl.vscode-test-explorer",
        "littlefoxteam.vscode-python-test-adapter",
        "mechatroner.rainbow-csv",
        "mohsen1.prettify-json",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "nicohlr.pycharm",
        "oderwat.indent-rainbow",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "shardulm94.trailing-spaces",
        "streetsidesoftware.code-spell-checker-russian",
        "streetsidesoftware.code-spell-checker",
        "tal7aouy.rainbow-bracket",
        "yzhang.markdown-all-in-one",
      ]
    }
  },
  "postCreateCommand": {
    "setupEnvironment": "uv python install 3.10 && uv venv --python 3.10 && sudo chown -R $(whoami): ${containerWorkspaceFolder}/.venv"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}",
    "SSH_AUTH_SOCK": "/ssh-agent",
    "WORKSPACE": "${containerWorkspaceFolder}",
    "UV_VENV_CLEAR": "1",
    "UV_LINK_MODE": "copy"
  },
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "mounts": [
        "source=${SSH_AUTH_SOCK},target=/ssh-agent,type=bind"
    ]
}
